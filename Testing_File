#include <stdio.h>

int main() {
    int counter = 1; 
    char input;

    while (counter > 0) {
        printf("Input a character to check validity!:");
        scanf(" %c", &input);

        if (input >= 'A' && input <= 'Z') {
            printf("The character '%c' is a valid uppercase letter.\n", input);
        } else if (input >= 'a' && input <= 'z') {
            printf("The character '%c' is a valid lowercase letter.\n", input);
        } else if (input >= '0' && input <= '9') {
            printf("The character '%c' is a valid digit.\n", input);
        } else {
            printf("The character '%c' is not a valid letter or digit.\n, exiting..", input);
        }
    }
    return 0;
}